INF = float('inf')

def prim_mst(graph):
    n = len(graph)

    selected = [False] * n
    key = [INF] * n
    parent = [-1] * n

    # Start from vertex 0
    key[0] = 0

    for _ in range(n):
        # Find the vertex with minimum key
        u = -1

        for v in range(n):
            if not selected[v] and (u == -1 or key[v] < key[u]):
                u = v

        # Include vertex in MST
        selected[u] = True

        # Update adjacent vertices
        for v in range(n):
            if graph[u][v] != 0 and not selected[v]:
                if graph[u][v] < key[v]:
                    key[v] = graph[u][v]
                    parent[v] = u

    # Print MST
    total_weight = 0

    print("Edge\tWeight")

    for v in range(1, n):
        print(parent[v], "-", v, "\t", graph[v][parent[v]])
        total_weight += graph[v][parent[v]]

    print("Total weight:", total_weight)


# Graph represented using an adjacency matrix
graph = [
    [0, 2, 0, 6, 0],
    [2, 0, 3, 8, 5],
    [0, 3, 0, 0, 7],
    [6, 8, 0, 0, 9],
    [0, 5, 7, 9, 0]
]

prim_mst(graph)
